# Auto-activate the local editing environment with direnv/nix-direnv.
# Approve once per clone with: direnv allow
use flake .#default

# Keep dependency synchronization explicit by default. Set DIRENV_AUTO_UV_SYNC=1
# if you want `uv sync --extra cpu --group dev` to run whenever the lock/config changes.
if [[ "${DIRENV_AUTO_UV_SYNC:-0}" == "1" ]]; then
  uv sync --frozen --extra cpu --group dev
fi
